# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# uv
uv.lock

# App runtime data (never commit user data)
.HolisticProcessingComputeAgent/
# Project-level skills the app picks up from the cwd. A real user commits
# these with their project; here they are only ever hand-testing leftovers.
.hpca/
# pixi environments
.pixi/*
!.pixi/config.toml

# Legacy log location (pre-chatlogs); still created by ad-hoc test runs
hpca-logs/
.snakemake/

# Where evals/edit_eval.py drops its run by default (--out). Regenerated by
# the next run, and a stale one at the repo root invites reading a number off
# a measurement nobody remembers taking.
results.json
